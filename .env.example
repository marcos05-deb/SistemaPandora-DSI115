APP_NAME=PANDORA
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=pandora
DB_USERNAME=pandora_app
DB_PASSWORD=strong_app_password
DB_ADMIN_USERNAME=pandora
DB_ADMIN_PASSWORD=pandora
DB_SSLMODE=prefer
DB_TIMEZONE=America/El_Salvador

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true

# Generar con: php -r "echo base64_encode(random_bytes(32));"
BLIND_INDEX_SECRET=

# Secreto maestro para derivar claves de cifrado por área clínica
# Generar con: php -r "echo base64_encode(random_bytes(32));"
AREA_KEY_SECRET=

# Solo desarrollo con Docker + Vite (docker compose up)
VITE_DEV_SERVER_URL=http://localhost:5173
